{
  "name": "opensasa-vscode",
  "displayName": "OpenSasa",
  "description": "Local-first AI coding workflow metadata for VS Code.",
  "version": "0.1.0-alpha.1",
  "publisher": "opensasa",
  "license": "MIT",
  "engines": {
    "vscode": ">=1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "opensasa.showStatus",
        "title": "OpenSasa: Show Status"
      },
      {
        "command": "opensasa.startSession",
        "title": "OpenSasa: Start Session"
      },
      {
        "command": "opensasa.finishSession",
        "title": "OpenSasa: Finish Session"
      },
      {
        "command": "opensasa.openDashboard",
        "title": "OpenSasa: Open Dashboard"
      }
    ],
    "configuration": {
      "title": "OpenSasa",
      "properties": {
        "opensasa.dbPath": {
          "type": "string",
          "description": "Override the local OpenSasa SQLite database path used by extension commands.",
          "scope": "machine-overridable"
        }
      }
    }
  },
  "scripts": {
    "check": "node --check src/cli.js && node --check src/config.js && node --check src/extension.js && node --check src/privacy-notice.js && node --check src/prompts.js && node --check src/status-bar.js"
  }
}
